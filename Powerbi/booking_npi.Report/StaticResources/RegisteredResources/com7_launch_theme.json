{
  "name": "COM7 NPI Launch",
  "dataColors": [
    "#5cb047",
    "#2a6fb8",
    "#e8833a",
    "#7a5bbd",
    "#c2456b",
    "#eda100",
    "#4a3aa7",
    "#2f9e8f"
  ],
  "good": "#5cb047",
  "neutral": "#eda100",
  "bad": "#c2456b",
  "maximum": "#22541a",
  "center": "#8ecb7c",
  "minimum": "#e6f2e1",
  "null": "#9a9da3",
  "background": "#ffffff",
  "secondaryBackground": "#f4f5f6",
  "tableAccent": "#5cb047",
  "foreground": "#20232a",
  "foregroundNeutralSecondary": "#5c5f66",
  "foregroundNeutralTertiary": "#9a9da3",
  "textClasses": {
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#20232a"
    },
    "largeTitle": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#20232a"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#5c5f66"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#5c5f66"
    },
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Light",
      "color": "#20232a"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e3e4e6"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#20232a"
              }
            },
            "background": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5c5f66"
              }
            },
            "labelDisplayUnits": 0
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5c5f66"
              }
            },
            "gridlineShow": false,
            "lineColor": {
              "solid": {
                "color": "#e3e4e6"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#9a9da3"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#e3e4e6"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#5c5f66"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Light",
            "color": {
              "solid": {
                "color": "#20232a"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#9a9da3"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e3e4e6"
              }
            },
            "radius": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#9a9da3"
              }
            }
          }
        ],
        "items": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#5c5f66"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#e3e4e6"
              }
            },
            "rowPadding": 5
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#5c5f66"
              }
            },
            "backColor": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "fontColorPrimary": {
              "solid": {
                "color": "#20232a"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#f4f5f6"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 4
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f4f5f6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#f4f5f6"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}