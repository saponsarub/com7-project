	column 'Launch Cohort' = VAR m = 'ci npi_iphone (2)'[clean_iPhone_model] RETURN SWITCH(TRUE(), m IN {"iPhone-15","iPhone-16","iPhone-17","iPhone-18"}, m, SEARCH("AIR", UPPER('ci npi_iphone (2)'[Model]), 1, 0) > 0, "iPhone-17", BLANK())
		dataType: string
		lineageTag: 329160f9-abb2-4ba2-8d6c-00d90d91db47
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Launch Open' = SWITCH('ci npi_iphone (2)'[Launch Cohort], "iPhone-15", DATE(2023,9,15), "iPhone-16", DATE(2024,9,13), "iPhone-17", DATE(2025,9,12), "iPhone-18", DATE(2026,9,12))
		dataType: dateTime
		formatString: Short Date
		lineageTag: 247adb1f-fac2-4301-b841-fe6b0fb51145
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Launch Day' = IF(ISBLANK('ci npi_iphone (2)'[Launch Open]), BLANK(), DATEDIFF('ci npi_iphone (2)'[Launch Open], 'ci npi_iphone (2)'[clean_bookdate], DAY))
		dataType: int64
		formatString: 0
		lineageTag: 292886f7-25ea-4dc7-a557-204c15562180
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Model No' = IFERROR(VALUE(SUBSTITUTE('ci npi_iphone (2)'[Launch Cohort], "iPhone-", "")), BLANK())
		dataType: int64
		formatString: 0
		lineageTag: ffd147f6-ea94-4a43-88db-a4c20d19957b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Test Row' = IF(LEFT('ci npi_iphone (2)'[Model], 5) = "DUMMY" || 'ci npi_iphone (2)'[booking_qty] > 10 || 'ci npi_iphone (2)'[booking_qty] <= 0, 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: 39027366-29e8-4d5b-978e-a5f53389436e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Launch Sale' = SWITCH('ci npi_iphone (2)'[Launch Cohort], "iPhone-15", DATE(2023,9,22), "iPhone-16", DATE(2024,9,20), "iPhone-17", DATE(2025,9,19), "iPhone-18", DATE(2026,9,18))
		dataType: dateTime
		formatString: Short Date
		lineageTag: b3325be7-3972-46a2-9fd5-c34352acad7b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Launch Window Days' = IF(ISBLANK('ci npi_iphone (2)'[Launch Open]), BLANK(), DATEDIFF('ci npi_iphone (2)'[Launch Open], 'ci npi_iphone (2)'[Launch Sale], DAY))
		dataType: int64
		formatString: 0
		lineageTag: 2c6b5c30-170a-494d-b0db-d3f3bf6badf3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'In Launch Window' = IF(NOT ISBLANK('ci npi_iphone (2)'[Launch Open]) && 'ci npi_iphone (2)'[clean_bookdate] >= 'ci npi_iphone (2)'[Launch Open] && 'ci npi_iphone (2)'[clean_bookdate] <= 'ci npi_iphone (2)'[Launch Sale], 1, 0)
		dataType: int64
		formatString: 0
		lineageTag: d6052720-6a4b-412a-9fd1-4c3cfab6dc79
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'ci npi_iphone (2)' = m
		mode: import
		source =
				let
				    Source = Sql.Database("192.168.43.250,18963", "_db1_3f9c2a7e-8b41-4d6f-9c25-1a7e5c0d2b8f"),
				    ci_npi_iphone = Source{[Schema="ci",Item="npi_iphone"]}[Data]
				in
				    ci_npi_iphone

