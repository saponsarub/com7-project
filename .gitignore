# ─────────────────────────────────────────────────────────────
#  ข้อมูลที่ห้ามขึ้น git
# ─────────────────────────────────────────────────────────────

# ไฟล์ข้อมูลลูกค้าจริง — ชื่อ เลขบัตร ที่อยู่ เบอร์โทร
data/
*.xlsx
*.xls
*.csv

# ยกเว้น: metadata ของฐานที่ไม่มี PII (ใช้เป็น data dictionary)
!COM7-Knowledge-Base/**/_raw/*.csv

# ไฟล์ lock ของ Excel
~$*

# credential
.env
.env.*
*credential*
*secret*

# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
#  ระบบปฏิบัติการ / เครื่องมือ
# ─────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Obsidian — เก็บโน้ต แต่ไม่เก็บ state ส่วนตัว
COM7-Knowledge-Base/.obsidian/workspace.json
COM7-Knowledge-Base/.obsidian/workspace-mobile.json
COM7-Knowledge-Base/.trash/

# ─────────────────────────────────────────────────────────────
#  ข้อมูล/ผลลัพธ์ที่ generate ใหม่ได้ — ไม่ต้องเก็บใน git
# ─────────────────────────────────────────────────────────────
# *.csv ถูกบล็อกอยู่แล้ว แต่ .gz กับ .parquet หลุดมาได้
*.csv.gz
*.parquet

# โฟลเดอร์ข้อมูลเข้า/ผลลัพธ์ของสคริปต์ทุกตัว
# _data/ มาจาก export SQL · _out/ สร้างใหม่ได้ด้วยการรันสคริปต์เสมอ
# ครอบทุก _out* เพราะเคยต้องสร้าง _out2/_out3 ชั่วคราวตอน Excel ล็อกไฟล์อยู่
scripts/itec/*/_data/
scripts/itec/*/_out/
scripts/*/_out/
scripts/*/_out[0-9]/
scripts/*/_data/

# zip ที่ build ไว้อัป Colab/Kaggle — สร้างใหม่ด้วย make_zip.py
scripts/itec/*/*.zip

# ─────────────────────────────────────────────────────────────
#  Power BI (.pbip) — เก็บเฉพาะไฟล์ข้อความ ไม่เก็บ cache/ค่าเครื่อง
# ─────────────────────────────────────────────────────────────
# cache.abf คือข้อมูลที่ import ไว้ — 96 MB และ generate ใหม่ได้ด้วย Refresh
Powerbi/**/.pbi/cache.abf
Powerbi/**/.pbi/localSettings.json
Powerbi/**/.pbi/editorSettings.json
Powerbi/_backup_definition_*/
*.pbix

# ─────────────────────────────────────────────────────────────
#  notebook ที่มี output ติดข้อมูลลูกค้าจริง
# ─────────────────────────────────────────────────────────────
# .ipynb เก็บผลการรันไว้ในไฟล์ — เซลล์ที่โชว์ df จะฝังชื่อ · ที่อยู่ ·
# เบอร์โทร · เลขสัญญา ของลูกค้าจริงลงไปด้วย ตรวจแล้วพบจริงในสองไฟล์นี้
# (wave_flood 40 เบอร์ · 40 เลขสัญญา · Untitled 40 เบอร์ · 40 เลขสัญญา)
# ถ้าจะเก็บเข้า git ต้อง Clear All Outputs ก่อน
wave_flood.ipynb
Untitled.ipynb
**/Untitled*.ipynb

# JupyterLab สร้างสำเนาไฟล์ที่เปิดอยู่ไว้ที่นี่ — ไม่ใช่ต้นฉบับ
.virtual_documents/
