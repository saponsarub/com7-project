# ─────────────────────────────────────────────────────────────
#  ข้อมูลที่ห้ามขึ้น git
# ─────────────────────────────────────────────────────────────

# ไฟล์ข้อมูลลูกค้าจริง — ชื่อ เลขบัตร ที่อยู่ เบอร์โทร
data/
*.xlsx
*.xls
*.csv

# ยกเว้น: metadata ของฐานที่ไม่มี PII (ใช้เป็น data dictionary)
!COM7-Knowledge-Base/**/_raw/*.csv

# ไฟล์ lock ของ Excel
~$*

# credential
.env
.env.*
*credential*
*secret*

# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
#  ระบบปฏิบัติการ / เครื่องมือ
# ─────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Obsidian — เก็บโน้ต แต่ไม่เก็บ state ส่วนตัว
COM7-Knowledge-Base/.obsidian/workspace.json
COM7-Knowledge-Base/.obsidian/workspace-mobile.json
COM7-Knowledge-Base/.trash/

# ─────────────────────────────────────────────────────────────
#  ข้อมูล/ผลลัพธ์ที่ generate ใหม่ได้ — ไม่ต้องเก็บใน git
# ─────────────────────────────────────────────────────────────
# *.csv ถูกบล็อกอยู่แล้ว แต่ .gz กับ .parquet หลุดมาได้
*.csv.gz
*.parquet

# โฟลเดอร์ข้อมูลเข้า/ผลลัพธ์ของสคริปต์ ITEC
# _data/  มาจาก export SQL · _out/ สร้างใหม่ได้จากโน้ตบุ๊กเสมอ
scripts/itec/*/_data/
scripts/itec/*/_out/

# zip ที่ build ไว้อัป Colab/Kaggle — สร้างใหม่ด้วย make_zip.py
scripts/itec/*/*.zip

# ─────────────────────────────────────────────────────────────
#  Power BI (.pbip) — เก็บเฉพาะไฟล์ข้อความ ไม่เก็บ cache/ค่าเครื่อง
# ─────────────────────────────────────────────────────────────
# cache.abf คือข้อมูลที่ import ไว้ — 96 MB และ generate ใหม่ได้ด้วย Refresh
Powerbi/**/.pbi/cache.abf
Powerbi/**/.pbi/localSettings.json
Powerbi/**/.pbi/editorSettings.json
Powerbi/_backup_definition_*/
*.pbix
